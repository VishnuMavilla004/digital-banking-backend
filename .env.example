
# Database configuration
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password
DB_HOST=localhost
DB_PORT=5432

# Application database
DB_NAME=digital_banking

# Isolated automated test database
DB_TEST_NAME=digital_banking_test

# JWT configuration
# Replace this with a random secret of at least 32 bytes.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
