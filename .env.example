
# Development database
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_banking

# Automated test database
DB_TEST_NAME=digital_banking_test

# JWT configuration
# Generate a random secret of at least 32 bytes for your local .env
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
